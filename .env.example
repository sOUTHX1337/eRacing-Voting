# Session
SESSION_SECRET=change-me-to-a-long-random-string

# Datenbank
DATABASE_URL=sqlite:///./voting.db

# LDAP
# LDAP_ENABLED=false nutzt statt eines echten LDAP-Servers lokale Test-Accounts
# aus app/dev_users.py (siehe DEV-Login-Hinweis auf der Login-Seite).
LDAP_ENABLED=false
LDAP_SERVER=ldaps://ldap.la-eracing.de
LDAP_BASE_DN=dc=la-eracing,dc=de
# {username} wird durch den eingegebenen Benutzernamen ersetzt
LDAP_BIND_DN_TEMPLATE=uid={username},ou=people,dc=la-eracing,dc=de
LDAP_ACTIVE_GROUP_DN=cn=aktive-mitglieder,ou=groups,dc=la-eracing,dc=de
# Mitglieder dieser Gruppe werden bei jedem Login automatisch zu Wahlleitung
# ernannt (nie automatisch entzogen). Zusaetzliche/abweichende Zuweisungen
# lassen sich in der App selbst unter /admin/mitglieder verwalten.
LDAP_WAHLLEITUNG_GROUP_DN=cn=wahlleitung,ou=groups,dc=la-eracing,dc=de
LDAP_ATTR_NAME=cn
LDAP_ATTR_EMAIL=mail
LDAP_ATTR_UID=uid
