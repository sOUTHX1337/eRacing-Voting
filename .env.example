# Session
SESSION_SECRET=change-me-to-a-long-random-string

# Datenbank
DATABASE_URL=sqlite:///./voting.db

# LDAP / Active Directory
# LDAP_ENABLED=false nutzt statt eines echten LDAP-Servers lokale Test-Accounts
# aus app/dev_users.py (siehe DEV-Login-Hinweis auf der Login-Seite).
# Diese Werte lassen sich nach dem Start auch dynamisch unter /admin/einstellungen
# pflegen (inkl. Verbindungstest) - dort haben sie dann Vorrang vor der .env.
LDAP_ENABLED=false
LDAP_SERVER=ldaps://euer-domain-controller:636
LDAP_BASE_DN=OU=AzureSync,DC=la-eracing,DC=com
# Active Directory bindet per UserPrincipalName, nicht per uid=... - {username}
# wird durch den eingegebenen Benutzernamen ersetzt.
LDAP_BIND_DN_TEMPLATE={username}@la-eracing.com
LDAP_ACTIVE_GROUP_DN=CN=Aktive-Mitglieder,OU=AzureSync,DC=la-eracing,DC=com
# Mitglieder dieser Gruppe werden bei jedem Login automatisch zu Wahlleitung
# ernannt (nie automatisch entzogen). Zusaetzliche/abweichende Zuweisungen
# lassen sich in der App selbst unter /admin/mitglieder verwalten.
LDAP_WAHLLEITUNG_GROUP_DN=CN=Wahlleitung,OU=AzureSync,DC=la-eracing,DC=com
LDAP_ATTR_NAME=displayName
LDAP_ATTR_EMAIL=mail
# Bei Active Directory sAMAccountName, NICHT uid (das gibt es dort nicht)
LDAP_ATTR_UID=sAMAccountName

# Notfall-Zugang (Break-Glass)
# Funktioniert immer, unabhaengig von LDAP_ENABLED und selbst wenn LDAP falsch
# konfiguriert ist - fuer den Fall, dass ihr euch aus /admin/einstellungen
# aussperrt. Leer lassen = deaktiviert. Unbedingt ein starkes Passwort setzen,
# z.B. mit: openssl rand -hex 16
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-something-strong
